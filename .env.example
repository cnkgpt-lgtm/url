# Salin nama variabel ini ke Environment Variables di Vercel (atau .env.local untuk lokal).
# JANGAN isi nilai asli di file ini dan jangan commit nilai asli ke repo.
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
NEXTAUTH_URL=
# Email akun Master pertama: pendaftar dengan email ini (persis, tidak peka huruf besar/kecil)
# otomatis menjadi role MASTER + status APPROVED. Semua pendaftar lain = USER + PENDING.
MASTER_EMAIL=
