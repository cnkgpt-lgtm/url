// Accank Arsip Link v2 — Prisma schema (PostgreSQL / Neon)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MASTER
  USER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  name         String?
  // Identitas login utama sejak v2.4: username (unik, lowercase).
  // Nullable agar akun lama (pra-username) tetap valid; diisi oleh
  // scripts/backfill-usernames.mjs untuk akun lama & saat daftar untuk akun baru.
  username     String?    @unique
  // Email hanya warisan internal (diisi `${username}@user.local` untuk akun baru);
  // tidak lagi dipakai untuk login dan tidak ditampilkan di UI mana pun.
  email        String     @unique
  passwordHash String
  // Kolom warisan dari versi persetujuan (approval): sudah TIDAK dipakai untuk
  // memblokir login. Semua pendaftar baru langsung aktif (APPROVED).
  role         Role       @default(USER)
  status       UserStatus @default(APPROVED)
  createdAt    DateTime   @default(now())
  categories   Category[]
  links        LinkItem[]
}

model Category {
  id     String     @id @default(cuid())
  name   String
  color  String
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  links  LinkItem[]

  @@unique([userId, name])
  @@index([userId])
}

model LinkItem {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  url           String
  normalizedUrl String
  title         String
  description   String    @default("")
  image         String    @default("")
  favicon       String    @default("")
  domain        String
  tags          String[]
  clicks        Int       @default(0)
  favorite      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, normalizedUrl])
}
